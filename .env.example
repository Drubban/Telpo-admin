APP_NAME="Telpo Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=telpo_admin
DB_USERNAME=telpo
DB_PASSWORD=cambia-esta-clave

# --- Sesion del administrador (cookie httpOnly) ---
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
# En produccion con HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# --- Telpo ---
# Genera una clave larga: php -r "echo bin2hex(random_bytes(24));"
TELPO_ENROLLMENT_KEY=
TELPO_ALLOW_HTTP=false
TELPO_BILLING_APP_PACKAGE=mx.transport.charge
TELPO_DATA_PLAN_GB=36
TELPO_ALERT_THRESHOLDS=25,50,75,90,100
# Destinatarios separados por coma. WhatsApp con codigo de pais, ej. +5215512345678
TELPO_ALERT_EMAILS=
TELPO_ALERT_WHATSAPP=
# none | twilio | meta
TELPO_WHATSAPP_DRIVER=none
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TEMPLATE=alerta_consumo_telpo
META_WHATSAPP_LANG=es_MX
TELPO_BILLING_CUTOFF_DAY=20
TELPO_TIMEZONE=America/Mexico_City
TELPO_ONLINE_MINUTES=30
# Opcional. Si se omite se usa APP_KEY.
HASHIDS_SALT=

# --- Administrador inicial (php artisan db:seed) ---
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Solo si hay un proxy inverso (nginx, balanceador) delante: IPs separadas por coma o *
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
